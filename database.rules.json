{
  "rules": {
    ".read": false,
    ".write": false,
    "grupos": {
      "$codigo": {
        ".read": "root.child('codigos').child($codigo).val() === true",
        ".write": "root.child('codigos').child($codigo).val() === true",
        "musicas": {
          "$id": {
            ".validate": "newData.hasChildren(['text', 'updated']) && newData.child('text').isString() && newData.child('text').val().length <= 60000 && newData.child('updated').isNumber() && $id.length <= 40"
          }
        },
        "repertorios": {
          "$id": {
            ".validate": "newData.hasChildren(['nome', 'updated']) && newData.child('nome').isString() && newData.child('nome').val().length <= 120 && newData.child('updated').isNumber() && $id.length <= 40"
          }
        },
        "editor": {
          ".validate": "newData.isString() && newData.val().length === 64"
        },
        "$outro": {
          ".validate": "$outro === 'palco'"
        }
      }
    }
  }
}
